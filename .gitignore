# Python bytecode and caches
__pycache__/
*.py[cod]
.pytest_cache/
.coverage
htmlcov/

# Virtual environments
myenv/
.venv/
venv/

# pytest --basetemp output. Named per invocation, so a new one appears
# whenever the suite is run with an explicit basetemp; Windows sometimes
# leaves one locked and undeletable, which must never block a commit.
.pytest_tmp*/

# Runtime-generated simulator data
runtime/
# The whole directory, not just data/*.json: the cross-process writers create
# extensionless NamedTemporaryFile spool files next to their target and rename
# them into place, so a run killed mid-write leaves temps that a narrower
# pattern would happily let someone commit.
data/
logs/*.jsonl
logs/*.log
results/*.xlsx
excel_exports/
# Every campaign dataset, not just the undated name: experiment_summary.csv
# is written per campaign day (experiment_summary_<YYYYMMDD>.csv) with
# paired_dv_<campaign>.csv beside it. All of it is run output, not source.
results/experiment_summary*.csv
results/paired_dv_*.csv
results/calibration_report_*.html
*.log
*.tmp

# Local secrets
.env
.env.*
!.env.example

# IDE and operating-system files
.vscode/
.idea/
Thumbs.db
.DS_Store
